# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# IDE / operating system
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local secrets and configuration
.env
.env.*
!.env.example

# Large local data (shared through Google Drive, never committed)
# Ignore every file under data/, regardless of its name or extension.
data/**
!data/**/
!data/**/.gitkeep

*.csv
*.parquet
*.arrow
*.feather
*.db
*.db-journal
*.sqlite
*.sqlite3

# Serialized model binaries: never commit, even if accidentally placed
# outside the canonical models/ directory.
*.joblib
*.pkl
*.pickle
*.onnx

# Generated runtime artifacts
outputs/**
artifacts/**
experiments/runs/**
experiments/tracking/**
models/**
!models/**/
!models/**/.gitkeep
!models/traditional_ml/README.md

# Small tracked baseline-training summary; model binaries and predictions remain local.
!reports/stage4/baseline_model_comparison.csv
!reports/stage4/baseline_model_comparison_*.csv
!reports/stage4/baseline_model_performance_comparison.csv
!reports/stage4/model_tuning/*.csv
!reports/stage4/stacking_fusion/*.csv
!reports/stage4/model_evaluation/*.csv
!reports/stage4/model_interpretability/*.csv

# Local execution logs and tool-specific temporary files
reports/stage4/**/issue*_stdout.log
reports/stage4/**/issue*_stderr.log
reports/stage4/model_dashboard/
.tmp-miktex-config/

# Local packaging / handoff files
project_*.zip
*_artifact_manifest.txt
local_backup/

# Keep the repository directory skeleton
!.gitkeep
!**/.gitkeep
